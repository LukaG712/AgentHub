{
  "productName": "AgentHub Desktop",
  "version": "1.0.3",
  "identifier": "com.agenthub.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../index.html",
    "frontendDist": "../index.html"
  },
  "app": {
    "windows": [
      {
        "title": "AgentHub Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://* ws://* wss://*; img-src 'self' data: http://*; media-src 'self' http://*; frame-src http://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installDir": "$LOCALAPPDATA\\agent-hub-desktop",
        "menu": true,
        "perMachine": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    }
  }
}
